<!doctype html><html lang="{$host_language|escape:'html':'UTF-8'}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{l s='Your rental' mod='colemanstay'} · 560 Coleman</title><link rel="stylesheet" href="/modules/colemanstay/views/css/tokens.css"><link rel="stylesheet" href="/modules/colemanstay/views/css/requests.css?v=6"><script src="/modules/colemanstay/views/js/requests.js?v=3" defer></script></head><body>
