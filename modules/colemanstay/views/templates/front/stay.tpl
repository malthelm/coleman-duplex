<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{if $coleman_detail == 'one'}Apartment One — {elseif $coleman_detail == 'two'}Apartment Two — {/if}560 Coleman · Highland Park</title>
<meta name="description" content="A private preview of two apartments at 560 Coleman Avenue, Highland Park, Los Angeles.">
<link rel="stylesheet" href="/modules/colemanstay/views/css/stay.css">
<script src="/modules/colemanstay/views/js/stay.js" defer></script>
</head>
<body>
<a class="skip" href="#main">{l s='Skip to content' mod='colemanstay'}</a>
<div class="demo-bar">{l s='PRIVATE DEMO' mod='colemanstay'} <span>·</span> {l s='Concept images. Test requests only. No reservations or payments.' mod='colemanstay'}</div>
<header class="site-header wrap">
<a class="wordmark" href="/" aria-label="{l s='560 Coleman home' mod='colemanstay'}"><span>560</span> Coleman<span class="wordmark-dot">.</span></a>
<nav aria-label="{l s='Main navigation' mod='colemanstay'}"><a href="/#apartments">{l s='The apartments' mod='colemanstay'}</a><a href="/#neighbourhood">{l s='Highland Park' mod='colemanstay'}</a><a class="button button-small" href="#request">{l s='Request a stay' mod='colemanstay'} <span aria-hidden="true">↗</span></a></nav>
</header>
<main id="main">
{if !$coleman_detail}
<section class="hero wrap" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow">{l s='HIGHLAND PARK, LOS ANGELES' mod='colemanstay'}</p><h1 id="hero-title">{l s='A little place' mod='colemanstay'}<br><em>{l s='in Los Angeles.' mod='colemanstay'}</em></h1><p class="intro">{l s='Two apartments. One Coleman Avenue address. Find your place, tell us your dates, and start a conversation.' mod='colemanstay'}</p><a class="text-link" href="#apartments">{l s='Explore the apartments' mod='colemanstay'} <span aria-hidden="true">↓</span></a><p class="hero-foot">560 COLEMAN AVENUE <span>01 / 02</span></p></div>
<figure class="hero-image"><img src="/modules/colemanstay/views/img/interior.png" alt="{l s='Illustrative living room concept with warm wood and afternoon light; not a photograph of the property' mod='colemanstay'}" width="1536" height="1024" fetchpriority="high"><figcaption>{l s='INTERIOR CONCEPT — PROPERTY PHOTOS COMING SOON' mod='colemanstay'}</figcaption></figure>
</section>
<section class="apartments wrap" id="apartments" aria-labelledby="apartments-title"><div class="section-top"><div><p class="eyebrow">{l s='TWO PLACES TO LAND' mod='colemanstay'}</p><h2 id="apartments-title">{l s='Make yourself at home.' mod='colemanstay'}</h2></div><p>{l s='Choose an apartment to explore. Details and rates will be confirmed before any booking.' mod='colemanstay'}</p></div>
<div class="apartment-grid">
<article class="apartment"><a class="apartment-image" href="/apartments/one/"><img src="/modules/colemanstay/views/img/interior.png" alt="{l s='Apartment One illustrative interior concept, not an actual property photo' mod='colemanstay'}" width="1536" height="1024" loading="lazy"><span class="image-tag">{l s='CONCEPT IMAGE' mod='colemanstay'}</span></a><div class="apartment-heading"><h3><a href="/apartments/one/">{l s='Apartment One' mod='colemanstay'}</a></h3><span class="unit-number">01</span></div><p>{l s='The first of two apartments at 560 Coleman. Explore the preview and let us know what you have in mind.' mod='colemanstay'}</p><div class="apartment-meta"><span>{l s='Details being prepared' mod='colemanstay'}</span><a class="text-link" href="/apartments/one/">{l s='Take a look' mod='colemanstay'} <span aria-hidden="true">↗</span></a></div></article>
<article class="apartment"><a class="apartment-image alternate" href="/apartments/two/"><img src="/modules/colemanstay/views/img/interior.png" alt="{l s='Apartment Two illustrative interior concept, not an actual property photo' mod='colemanstay'}" width="1536" height="1024" loading="lazy"><span class="image-tag">{l s='CONCEPT IMAGE' mod='colemanstay'}</span></a><div class="apartment-heading"><h3><a href="/apartments/two/">{l s='Apartment Two' mod='colemanstay'}</a></h3><span class="unit-number">02</span></div><p>{l s='Another place at the same address. Send your preferred dates and we will work through the details together.' mod='colemanstay'}</p><div class="apartment-meta"><span>{l s='Details being prepared' mod='colemanstay'}</span><a class="text-link" href="/apartments/two/">{l s='Take a look' mod='colemanstay'} <span aria-hidden="true">↗</span></a></div></article>
</div></section>
<section class="neighbourhood" id="neighbourhood"><div class="wrap neighbourhood-inner"><div><p class="eyebrow">{l s='THE ADDRESS' mod='colemanstay'}</p><h2>{l s='Hello, Highland Park.' mod='colemanstay'}</h2></div><div><p>{l s='560 Coleman Avenue' mod='colemanstay'}<br>{l s='Highland Park, Los Angeles, California' mod='colemanstay'}</p><p class="muted">{l s='Our neighbourhood guide is on its way. For now, tell us what brings you to this corner of Los Angeles.' mod='colemanstay'}</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=560+Coleman+Ave+Los+Angeles+CA" target="_blank" rel="noopener noreferrer">{l s='Find the address' mod='colemanstay'} <span aria-hidden="true">↗</span><span class="sr-only">{l s='opens in a new tab' mod='colemanstay'}</span></a></div></div></section>
{else}
<section class="detail wrap"><a class="text-link" href="/#apartments">← {l s='Both apartments' mod='colemanstay'}</a><div class="detail-heading"><div><p class="eyebrow">560 COLEMAN · HIGHLAND PARK</p><h1>{if $coleman_detail == 'one'}{l s='Apartment One' mod='colemanstay'}{else}{l s='Apartment Two' mod='colemanstay'}{/if}</h1></div><a class="button" href="#request">{l s='Request your dates' mod='colemanstay'} ↗</a></div><figure class="detail-image"><img src="/modules/colemanstay/views/img/interior.png" alt="{l s='Illustrative interior concept only; actual apartment photos are not yet available' mod='colemanstay'}" width="1536" height="1024"><figcaption>{l s='INTERIOR CONCEPT — NOT AN ACTUAL PROPERTY PHOTO' mod='colemanstay'}</figcaption></figure><div class="detail-description"><h2>{l s='Start with your dates.' mod='colemanstay'}</h2><div><p>{l s='This apartment is part of the duplex at 560 Coleman Avenue in Highland Park, Los Angeles.' mod='colemanstay'}</p><p>{l s='We are preparing the real photos, floor plan and apartment details. Bedrooms, guest capacity, amenities, pricing and availability are still to be confirmed.' mod='colemanstay'}</p><p>{l s='You can try the request form below. This private demo records enquiries for review only.' mod='colemanstay'}</p></div></div></section>
{/if}
<section class="request-section wrap" id="request" aria-labelledby="request-title"><div class="request-intro"><p class="eyebrow">{l s='LET’S START A CONVERSATION' mod='colemanstay'}</p><h2 id="request-title">{l s='Your stay,' mod='colemanstay'}<br><em>{l s='your own pace.' mod='colemanstay'}</em></h2><p>{l s='A few nights or a longer chapter? Tell us which apartment you are interested in and when you would like to come.' mod='colemanstay'}</p><ol class="steps"><li>{l s='Choose an apartment and your dates.' mod='colemanstay'}</li><li>{l s='The host reviews your request.' mod='colemanstay'}</li><li>{l s='Agree on availability, price and terms.' mod='colemanstay'}</li></ol><p class="fine-print">{l s='This is a private demo. Requests are saved to the host inbox. No email is sent, no payment is taken, and no dates are reserved. Please use test contact details.' mod='colemanstay'}</p></div>
<div class="request-panel">
{if $coleman_receipt}
<div class="success" role="status" tabindex="-1" id="request-result"><span class="success-icon" aria-hidden="true">✓</span><p class="eyebrow">{l s='SAVED TO THE DEMO INBOX' mod='colemanstay'}</p><h3>{l s='Your request is in.' mod='colemanstay'}</h3><p>{l s='Reference' mod='colemanstay'} <strong>{$coleman_receipt|escape:'html':'UTF-8'}</strong></p><p>{l s='The host can now review this test enquiry. This is not a booking confirmation. No email has been sent and your dates have not been held.' mod='colemanstay'}</p><a class="button" href="/#request">{l s='Try another request' mod='colemanstay'} ↗</a></div>
{elseif !$coleman_ready}
<div role="status"><h3>{l s='The apartments are being prepared.' mod='colemanstay'}</h3><p>{l s='The request form will be available once both apartments are set up. Please check back shortly.' mod='colemanstay'}</p><a class="text-link" href="/">{l s='Refresh the preview' mod='colemanstay'}</a></div>
{else}
{if $coleman_errors}<div class="form-errors" role="alert" tabindex="-1" id="request-result"><h3>{l s='Please check your request.' mod='colemanstay'}</h3><ul>{foreach $coleman_errors as $error}<li>{$error|escape:'html':'UTF-8'}</li>{/foreach}</ul></div>{/if}
<form method="post" action="/#request" id="stay-form" data-saving="{l s='Saving your demo request…' mod='colemanstay'}">
<input type="hidden" name="csrf" value="{$coleman_csrf|escape:'html':'UTF-8'}"><input type="hidden" name="request_token" value="{$coleman_token|escape:'html':'UTF-8'}">
<div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
<label for="apartment">{l s='Which apartment?' mod='colemanstay'}</label><select name="apartment" id="apartment" required><option value="">{l s='Choose an apartment' mod='colemanstay'}</option><option value="one" {if $coleman_form.apartment == 'one'}selected{/if}>{l s='Apartment One' mod='colemanstay'}</option><option value="two" {if $coleman_form.apartment == 'two'}selected{/if}>{l s='Apartment Two' mod='colemanstay'}</option></select>
<div class="form-row"><div><label for="arrival">{l s='Arrival' mod='colemanstay'}</label><input id="arrival" name="arrival" type="date" min="{$coleman_today|escape:'html':'UTF-8'}" value="{$coleman_form.arrival|escape:'html':'UTF-8'}" required></div><div><label for="departure">{l s='Departure' mod='colemanstay'}</label><input id="departure" name="departure" type="date" min="{$coleman_today|escape:'html':'UTF-8'}" value="{$coleman_form.departure|escape:'html':'UTF-8'}" required></div></div>
<div class="form-row name-row"><div><label for="guest-name">{l s='Your name' mod='colemanstay'}</label><input id="guest-name" name="guest_name" autocomplete="name" maxlength="120" value="{$coleman_form.guest_name|escape:'html':'UTF-8'}" required></div><div><label for="guests">{l s='Guests' mod='colemanstay'}</label><input id="guests" name="guests" type="number" min="1" max="8" value="{$coleman_form.guests|escape:'html':'UTF-8'}" required aria-describedby="capacity-note"></div></div><p class="field-note" id="capacity-note">{l s='Guest capacity is subject to host confirmation.' mod='colemanstay'}</p>
<label for="email">{l s='Email address' mod='colemanstay'}</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" value="{$coleman_form.email|escape:'html':'UTF-8'}" required>
<label for="message">{l s='Anything you’d like us to know?' mod='colemanstay'} <span class="optional">{l s='optional' mod='colemanstay'}</span></label><textarea id="message" name="message" rows="3" maxlength="2000" placeholder="{l s='Dates flexible? Planning a longer stay?' mod='colemanstay'}">{$coleman_form.message|escape:'html':'UTF-8'}</textarea>
<label class="checkbox"><input type="checkbox" name="demo_consent" value="1" required><span>{l s='I understand this is a demo request, not a confirmed booking. My test details will be stored for the host to review.' mod='colemanstay'}</span></label>
<button class="button submit" type="submit">{l s='Send demo request' mod='colemanstay'} <span aria-hidden="true">↗</span></button><p id="submit-status" class="field-note" role="status"></p>
</form>
{/if}
</div></section>
</main>
<footer class="site-footer wrap"><a class="wordmark" href="/">560 Coleman.</a><p>HIGHLAND PARK · LOS ANGELES</p><div><a href="/host-admin/">{l s='Host login' mod='colemanstay'}</a><a href="https://github.com/malthelm/coleman-duplex/tree/codex/coleman-demo">{l s='Source · QloApps / OSL-3.0' mod='colemanstay'}</a></div></footer>
</body></html>
