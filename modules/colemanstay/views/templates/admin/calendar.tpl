<div class="page-heading"><h1>{l s='Availability' mod='colemanstay'}</h1><p>{l s='Reserve stays and keep personal dates off the calendar.' mod='colemanstay'}</p></div>
<form class="calendar-picker" method="get" action="index.php"><input type="hidden" name="controller" value="AdminColemanRequests"><input type="hidden" name="token" value="{$token|escape:'html':'UTF-8'}"><input type="hidden" name="view" value="calendar">
<label>{l s='Apartment' mod='colemanstay'}<select name="id_product">{foreach $units as $unit}<option value="{$unit.id_product|intval}"{if $selected_unit == $unit.id_product} selected{/if}>{$unit.name|escape:'html':'UTF-8'} · {$unit.address|escape:'html':'UTF-8'}</option>{/foreach}</select></label>
<label>{l s='Month' mod='colemanstay'}<input type="month" name="month" value="{$calendar_month|escape:'html':'UTF-8'}" required></label><button class="button secondary" type="submit">{l s='Show calendar' mod='colemanstay'}</button></form>
<div class="calendar-layout">
<section class="calendar-panel" aria-labelledby="calendar-title">
<div class="calendar-heading"><h2 id="calendar-title">{$month_label|escape:'html':'UTF-8'}</h2><nav aria-label="{l s='Change month' mod='colemanstay'}"><a href="{$inbox_url|escape:'html':'UTF-8'}&amp;view=calendar&amp;id_product={$selected_unit|intval}&amp;month={$previous_month|escape:'html':'UTF-8'}" aria-label="{l s='Previous month' mod='colemanstay'}"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></a><a href="{$inbox_url|escape:'html':'UTF-8'}&amp;view=calendar&amp;id_product={$selected_unit|intval}&amp;month={$next_month|escape:'html':'UTF-8'}" aria-label="{l s='Next month' mod='colemanstay'}"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></nav></div>
<table class="calendar-grid"><caption class="sr-only">{$month_label|escape:'html':'UTF-8'} {l s='blocked nights' mod='colemanstay'}</caption><thead><tr><th scope="col">{l s='Mon' mod='colemanstay'}</th><th scope="col">{l s='Tue' mod='colemanstay'}</th><th scope="col">{l s='Wed' mod='colemanstay'}</th><th scope="col">{l s='Thu' mod='colemanstay'}</th><th scope="col">{l s='Fri' mod='colemanstay'}</th><th scope="col">{l s='Sat' mod='colemanstay'}</th><th scope="col">{l s='Sun' mod='colemanstay'}</th></tr></thead><tbody>
{foreach $calendar_weeks as $week}<tr>{foreach $week as $day}<td class="{if $day.kind}is-{$day.kind|escape:'html':'UTF-8'}{/if}{if $day.outside} outside-month{/if}"><time datetime="{$day.date|escape:'html':'UTF-8'}"{if $day.today} aria-current="date"{/if}><span aria-hidden="true">{$day.number|intval}</span><span class="sr-only">{$day.full|escape:'html':'UTF-8'}</span></time><span class="day-state">{if $day.kind == 'reserved'}{l s='Reserved' mod='colemanstay'}{elseif $day.kind == 'blocked'}{l s='Blocked' mod='colemanstay'}{else}<span class="sr-only">{l s='No block' mod='colemanstay'}</span>{/if}</span></td>{/foreach}</tr>{/foreach}
</tbody></table>
<p class="field-hint">{l s='Shaded days are blocked nights. Checkout day is not blocked. An unshaded date is not a confirmed offer of availability.' mod='colemanstay'}</p>
</section>
<aside class="block-panel"><h2>{l s='Block dates' mod='colemanstay'}</h2><p class="muted">{l s='For personal use, maintenance, or another commitment.' mod='colemanstay'}</p>
<form class="host-form" method="post" action="{$inbox_url|escape:'html':'UTF-8'}&amp;view=calendar" data-saving="{l s='Saving…' mod='colemanstay'}">
<input type="hidden" name="token" value="{$token|escape:'html':'UTF-8'}"><input type="hidden" name="id_product" value="{$selected_unit|intval}"><input type="hidden" name="month" value="{$calendar_month|escape:'html':'UTF-8'}">
<fieldset{if !$can_review} disabled{/if}><legend class="sr-only">{l s='New date block' mod='colemanstay'}</legend>
<label>{l s='First night' mod='colemanstay'}<input type="date" name="arrival" min="{$today|escape:'html':'UTF-8'}" max="{$max_date|escape:'html':'UTF-8'}" value="{$block_form.arrival|escape:'html':'UTF-8'}" required></label>
<label>{l s='Available again' mod='colemanstay'}<input type="date" name="departure" min="{$today|escape:'html':'UTF-8'}" max="{$max_date|escape:'html':'UTF-8'}" value="{$block_form.departure|escape:'html':'UTF-8'}" required></label>
<label>{l s='Reason (host only)' mod='colemanstay'}<input type="text" name="label" maxlength="160" value="{$block_form.label|escape:'html':'UTF-8'}" required></label><button class="button primary" type="submit" name="decision" value="blocked">{l s='Block dates' mod='colemanstay'}</button>
</fieldset></form></aside>
</div>
<section class="calendar-entries"><h2>{l s='Blocks and stays in this view' mod='colemanstay'}</h2>
{foreach $blocks as $block}<article class="calendar-entry"><div><h3>{$block.label|escape:'html':'UTF-8'}</h3><p>{$block.arrival|date_format:'%b %e, %Y'|escape:'html':'UTF-8'} — {$block.departure|date_format:'%b %e, %Y'|escape:'html':'UTF-8'}</p><span class="status {if $block.request_id}reserved{else}pending{/if}">{if $block.request_id}{l s='Reserved stay' mod='colemanstay'}{else}{l s='Manual block' mod='colemanstay'}{/if}</span></div>
{if $block.request_id}<a href="{$inbox_url|escape:'html':'UTF-8'}&amp;status=reserved">{l s='Review reservation' mod='colemanstay'}</a>{elseif $can_review}<form class="host-form" method="post" action="{$inbox_url|escape:'html':'UTF-8'}&amp;view=calendar" data-saving="{l s='Saving…' mod='colemanstay'}"><input type="hidden" name="token" value="{$token|escape:'html':'UTF-8'}"><input type="hidden" name="id_product" value="{$selected_unit|intval}"><input type="hidden" name="month" value="{$calendar_month|escape:'html':'UTF-8'}"><input type="hidden" name="block_id" value="{$block.id_coleman_calendar|intval}"><input type="hidden" name="revision" value="{$block.revision|intval}"><button class="button secondary" type="submit" name="decision" value="unblocked">{l s='Release block' mod='colemanstay'}</button></form>{/if}</article>
{foreachelse}<p class="muted">{l s='No blocked dates or reserved stays in this view.' mod='colemanstay'}</p>{/foreach}
</section>

{include file='./calendar-exchange.tpl'}
