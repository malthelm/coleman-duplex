{if !$rental}<div class="empty-state"><h1>{l s='Rental not found' mod='colemanstay'}</h1><p>{l s='Return to applications and choose a rental record.' mod='colemanstay'}</p></div>{else}
<div class="page-heading"><p class="eyebrow">{$rental.reference|escape:'html':'UTF-8'} · {l s='Apartment' mod='colemanstay'} {$rental.unit|intval}</p><h1>{if $is_portal}{l s='Your rental' mod='colemanstay'}{else}{$rental.name|escape:'html':'UTF-8'}{/if}</h1><p>{l s='From the first application to feeling at home.' mod='colemanstay'}</p>{if !$is_portal}<a href="{$inbox_url|escape:'html':'UTF-8'}&amp;view=application&amp;application_id={$rental.id|intval}">{l s='Enquiry & progress' mod='colemanstay'}</a>{/if}</div>
{if $rental_saved}<div class="notice success" role="status">{l s='Saved. Your rental record is up to date.' mod='colemanstay'}</div>{/if}
<nav class="filters rental-tabs" aria-label="{l s='Rental sections' mod='colemanstay'}"><a href="{$rental_url|escape:'html':'UTF-8'}{if $is_portal}?{else}&amp;{/if}section=application"{if $rental_section == 'application'} aria-current="page"{/if}>{l s='Application' mod='colemanstay'}</a><a href="{$rental_url|escape:'html':'UTF-8'}{if $is_portal}?{else}&amp;{/if}section=lease"{if $rental_section == 'lease'} aria-current="page"{/if}>{l s='Lease & move-in' mod='colemanstay'}</a><a href="{$rental_url|escape:'html':'UTF-8'}{if $is_portal}?{else}&amp;{/if}section=rent"{if $rental_section == 'rent'} aria-current="page"{/if}>{l s='Rent' mod='colemanstay'}</a><a href="{$rental_url|escape:'html':'UTF-8'}{if $is_portal}?{else}&amp;{/if}section=maintenance"{if $rental_section == 'maintenance'} aria-current="page"{/if}>{l s='Maintenance' mod='colemanstay'}</a></nav>
<fieldset class="rental-workspace"{if !$is_portal && !$can_review} disabled{/if}>
{if $rental_section == 'application'}
<div class="message-layout"><section class="rental-card"><h2>{l s='Application details' mod='colemanstay'}</h2><p class="field-hint">{if $rental.profile.submitted}{l s='Submitted' mod='colemanstay'} · {$rental.profile.submitted|escape:'html':'UTF-8'} UTC{else}{l s='Draft · Not yet submitted' mod='colemanstay'}{/if}</p>
<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<fieldset{if !$is_portal || $rental.profile.submitted} disabled{/if}>
<label for="phone">{l s='Phone' mod='colemanstay'}</label><input id="phone" name="phone" value="{$rental.profile.phone|escape:'html':'UTF-8'}" maxlength="40" type="tel" autocomplete="tel">
<label for="address">{l s='Current address' mod='colemanstay'}</label><textarea id="address" name="address" maxlength="500" rows="2">{$rental.profile.address|escape:'html':'UTF-8'}</textarea>
<label for="household">{l s='Who will live here?' mod='colemanstay'}</label><textarea id="household" name="household" maxlength="1000" rows="3">{$rental.profile.household|escape:'html':'UTF-8'}</textarea>
<label for="history">{l s='Rental history' mod='colemanstay'}</label><textarea id="history" name="history" maxlength="2000" rows="3">{$rental.profile.history|escape:'html':'UTF-8'}</textarea>
<label for="work">{l s='Employment or income summary (optional)' mod='colemanstay'}</label><textarea id="work" name="work" maxlength="1000" rows="3">{$rental.profile.work|escape:'html':'UTF-8'}</textarea>
<label for="references">{l s='References (optional, with their permission)' mod='colemanstay'}</label><textarea id="references" name="references" maxlength="1000" rows="3">{$rental.profile.references|escape:'html':'UTF-8'}</textarea>
<label for="notes">{l s='Anything else? (optional)' mod='colemanstay'}</label><textarea id="notes" name="notes" maxlength="2000" rows="3">{$rental.profile.notes|escape:'html':'UTF-8'}</textarea>
{if $is_portal && !$rental.profile.submitted}<label class="check"><input type="checkbox" name="confirm" value="1">{l s='I have checked these details and have permission to share any references. This preview contains test information only.' mod='colemanstay'}</label><div class="actions"><button class="button secondary" name="operation" value="profile_save">{l s='Save draft' mod='colemanstay'}</button><button class="button primary" name="operation" value="profile_submit">{l s='Submit application' mod='colemanstay'}</button></div><p class="field-hint">{l s='Phone, address, household and rental history are needed to submit. Submission does not approve a tenancy.' mod='colemanstay'}</p>{/if}</fieldset></form>
{if !$is_portal && $rental.profile.submitted}<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<button class="button secondary" name="operation" value="reopen">{l s='Reopen for corrections' mod='colemanstay'}</button></form>{/if}</section>
<aside class="message-context">{if $is_portal}<h2>{l s='Before you submit' mod='colemanstay'}</h2><p>{l s='Save a draft and come back when you are ready. Once submitted, your host can reopen the application for corrections.' mod='colemanstay'}</p><p>{l s='Do not include Social Security numbers, banking credentials or identity documents.' mod='colemanstay'}</p>{else}<h2>{l s='Applicant access' mod='colemanstay'}</h2><p>{l s='Share the portal address, rental reference and private code directly with the intended applicant.' mod='colemanstay'}</p><p><a href="/portal">{l s='Open the rental portal' mod='colemanstay'}</a></p>{if $rental.access_expires}<p>{l s='Code expires' mod='colemanstay'}: {$rental.access_expires|escape:'html':'UTF-8'} UTC</p>{else}<p>{l s='Portal access is off.' mod='colemanstay'}</p>{/if}
{if $access_code}<div class="notice success"><strong>{l s='Copy this code now. It is shown only once.' mod='colemanstay'}</strong><code class="access-code">{$access_code|escape:'html':'UTF-8'}</code></div>{/if}
<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<button class="button primary" name="operation" value="access_issue">{if $rental.access_expires}{l s='Replace access code' mod='colemanstay'}{else}{l s='Issue access code' mod='colemanstay'}{/if}</button>{if $rental.access_expires}<button class="button secondary" name="operation" value="access_revoke">{l s='Revoke access' mod='colemanstay'}</button>{/if}</form><p class="field-hint">{l s='Replacing or revoking a code also ends existing portal access. No email is sent.' mod='colemanstay'}</p>{/if}</aside></div>
{elseif $rental_section == 'lease'}
<div class="message-layout"><section class="rental-card"><h2>{l s='Lease & move-in' mod='colemanstay'}</h2><p class="field-hint">{l s='Manual records of agreed terms. Saving here does not sign a lease or reserve dates.' mod='colemanstay'}</p><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<fieldset{if $is_portal} disabled{/if}>
<div class="rental-grid"><div><label for="start">{l s='Lease starts' mod='colemanstay'}</label><input type="date" id="start" name="start" value="{$rental.lease.start|escape:'html':'UTF-8'}"></div><div><label for="end">{l s='Lease ends (blank if undecided or open-ended)' mod='colemanstay'}</label><input type="date" id="end" name="end" value="{$rental.lease.end|escape:'html':'UTF-8'}"></div></div>
<label for="rent">{l s='Monthly rent · USD' mod='colemanstay'}</label><input id="rent" name="rent" inputmode="decimal" value="{$rental.lease.rent|escape:'html':'UTF-8'}" placeholder="{l s='Not confirmed' mod='colemanstay'}">
<div class="rental-grid"><div><label for="deposit_due">{l s='Deposit due · USD' mod='colemanstay'}</label><input id="deposit_due" name="deposit_due" inputmode="decimal" value="{$rental.lease.deposit_due|escape:'html':'UTF-8'}"></div><div><label for="deposit_received">{l s='Deposit received · USD' mod='colemanstay'}</label><input id="deposit_received" name="deposit_received" inputmode="decimal" value="{$rental.lease.deposit_received|escape:'html':'UTF-8'}"></div></div>
<label for="signature">{l s='Signing status (recorded by host)' mod='colemanstay'}</label><select id="signature" name="signature"><option value="not_sent"{if $rental.lease.signature == 'not_sent'} selected{/if}>{l s='Not sent' mod='colemanstay'}</option><option value="sent"{if $rental.lease.signature == 'sent'} selected{/if}>{l s='Sent for signature' mod='colemanstay'}</option><option value="partially_signed"{if $rental.lease.signature == 'partially_signed'} selected{/if}>{l s='Partially signed' mod='colemanstay'}</option><option value="signed"{if $rental.lease.signature == 'signed'} selected{/if}>{l s='Signed' mod='colemanstay'}</option></select><label for="signed_on">{l s='Signed on' mod='colemanstay'}</label><input type="date" id="signed_on" name="signed_on" value="{$rental.lease.signed_on|escape:'html':'UTF-8'}">
<h3>{l s='Move-in checklist' mod='colemanstay'}</h3><label class="check"><input type="checkbox" name="keys" value="1"{if $rental.lease.keys} checked{/if}>{l s='Keys handed over' mod='colemanstay'}</label><label class="check"><input type="checkbox" name="inventory" value="1"{if $rental.lease.inventory} checked{/if}>{l s='Condition and inventory reviewed' mod='colemanstay'}</label><label class="check"><input type="checkbox" name="utilities" value="1"{if $rental.lease.utilities} checked{/if}>{l s='Utilities arranged' mod='colemanstay'}</label><label class="check"><input type="checkbox" name="maintenance_enabled" value="1"{if $rental.lease.maintenance_enabled} checked{/if}>{l s='Enable resident maintenance requests' mod='colemanstay'}</label>
{if !$is_portal}<button class="button primary" name="operation" value="lease_save">{l s='Save lease & move-in' mod='colemanstay'}</button>{/if}</fieldset></form></section>
<aside class="message-context"><h2>{l s='Lease documents' mod='colemanstay'}</h2><p>{l s='Each upload is kept as a separate version. Files are private to this rental.' mod='colemanstay'}</p>{foreach $rental.files as $file}{if $file.kind == 'lease'}<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form file-row">{include file='./tenancy-fields.tpl'}<input type="hidden" name="file_id" value="{$file.id|escape:'html':'UTF-8'}"><p>{$file.date|escape:'html':'UTF-8'} UTC · PDF</p><button class="button secondary" name="operation" value="file_download">{l s='Download lease' mod='colemanstay'}</button></form>{/if}{/foreach}
{if !$is_portal}<form method="post" enctype="multipart/form-data" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<label for="document">{l s='Add a lease version · PDF, up to 8 MB' mod='colemanstay'}</label><input type="file" id="document" name="document" accept="application/pdf" required><label class="check"><input type="checkbox" name="confirm" value="1" required>{l s='This is the owner-approved document for this rental, safe to share with its applicant.' mod='colemanstay'}</label><button class="button secondary" name="operation" value="lease_upload">{l s='Upload lease' mod='colemanstay'}</button></form>{/if}</aside></div>
{elseif $rental_section == 'rent'}
<div class="rental-summary"><div><span>{l s='Outstanding rent' mod='colemanstay'}</span><strong>${($rental.balance/100)|string_format:'%.2f'|escape:'html':'UTF-8'} <small>USD</small></strong></div><p>{l s='Manual rent ledger. Payments shown here were entered by the host; this website does not collect money.' mod='colemanstay'}</p>{if !$is_portal}<form method="post" action="{$rental_url|escape:'html':'UTF-8'}">{include file='./tenancy-fields.tpl'}<button class="button secondary" name="operation" value="csv">{l s='Export CSV' mod='colemanstay'}</button></form>{/if}</div>
<div class="message-layout"><section><h2>{l s='Monthly charges' mod='colemanstay'}</h2>
{foreach $rental.charges as $charge}<article class="rental-card ledger-entry"><div class="request-heading"><h3>{$charge.period|escape:'html':'UTF-8'}</h3><span class="status {$charge.state|escape:'html':'UTF-8'}">{if $charge.state == 'void'}{l s='Void' mod='colemanstay'}{elseif $charge.state == 'paid'}{l s='Paid' mod='colemanstay'}{elseif $charge.state == 'overdue'}{l s='Overdue' mod='colemanstay'}{elseif $charge.state == 'partial'}{l s='Part paid' mod='colemanstay'}{else}{l s='Due' mod='colemanstay'}{/if}</span></div><p class="field-hint">{l s='Due' mod='colemanstay'} {$charge.due|escape:'html':'UTF-8'} · #{$charge.id|intval}</p><dl class="rental-totals"><div><dt>{l s='Charge' mod='colemanstay'}</dt><dd>${($charge.amount/100)|string_format:'%.2f'|escape:'html':'UTF-8'}</dd></div><div><dt>{l s='Paid' mod='colemanstay'}</dt><dd>${($charge.paid/100)|string_format:'%.2f'|escape:'html':'UTF-8'}</dd></div><div><dt>{l s='Remaining' mod='colemanstay'}</dt><dd>${($charge.balance/100)|string_format:'%.2f'|escape:'html':'UTF-8'}</dd></div></dl>
{if $charge.void_reason}<p>{l s='Void reason' mod='colemanstay'}: {$charge.void_reason|escape:'html':'UTF-8'}</p>{elseif !$is_portal}
{if $charge.balance > 0}<details><summary>{l s='Record a payment' mod='colemanstay'}</summary><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="charge_id" value="{$charge.id|intval}"><label for="amount-{$charge.id|intval}">{l s='Amount received · USD' mod='colemanstay'}</label><input id="amount-{$charge.id|intval}" name="amount" inputmode="decimal" required><label for="received-{$charge.id|intval}">{l s='Received on' mod='colemanstay'}</label><input id="received-{$charge.id|intval}" type="date" name="received" required><label for="method-{$charge.id|intval}">{l s='Payment method' mod='colemanstay'}</label><select id="method-{$charge.id|intval}" name="method"><option value="bank">{l s='Bank transfer' mod='colemanstay'}</option><option value="cash">{l s='Cash' mod='colemanstay'}</option><option value="card">{l s='Card (processed elsewhere)' mod='colemanstay'}</option><option value="other">{l s='Other' mod='colemanstay'}</option></select><label for="reference-{$charge.id|intval}">{l s='Reference (optional)' mod='colemanstay'}</label><input id="reference-{$charge.id|intval}" name="reference" maxlength="120"><button class="button primary" name="operation" value="payment_add">{l s='Record payment' mod='colemanstay'}</button></form></details>{/if}
{if $charge.paid == 0}<details><summary>{l s='Correct this charge' mod='colemanstay'}</summary><p class="field-hint">{l s='Void this entry, then add a corrected charge. The original will stay in the history.' mod='colemanstay'}</p><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="entry_id" value="{$charge.id|intval}"><label for="charge-reason-{$charge.id|intval}">{l s='Reason' mod='colemanstay'}</label><input id="charge-reason-{$charge.id|intval}" name="reason" maxlength="500" required><button class="button secondary" name="operation" value="charge_void">{l s='Void charge' mod='colemanstay'}</button></form></details>{/if}{/if}</article>{foreachelse}<div class="rental-card"><p>{l s='No rent charges yet.' mod='colemanstay'}</p></div>{/foreach}
<h2>{l s='Payment records' mod='colemanstay'}</h2>{foreach $rental.payments as $payment}<article class="rental-card ledger-entry"><h3>${($payment.amount/100)|string_format:'%.2f'|escape:'html':'UTF-8'} · {$payment.received|escape:'html':'UTF-8'}</h3><p class="field-hint">{l s='Payment' mod='colemanstay'} #{$payment.id|intval} · {l s='Charge' mod='colemanstay'} #{$payment.charge_id|intval} · {$payment.method|escape:'html':'UTF-8'}</p>{if $payment.reference}<p>{$payment.reference|escape:'html':'UTF-8'}</p>{/if}{if $payment.void_reason}<p>{l s='VOID' mod='colemanstay'}: {$payment.void_reason|escape:'html':'UTF-8'}</p>{/if}<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="entry_id" value="{$payment.id|intval}"><button class="button secondary" name="operation" value="receipt">{l s='Download receipt' mod='colemanstay'}</button></form>{if !$is_portal && !$payment.void_reason}<details><summary>{l s='Correct this payment' mod='colemanstay'}</summary><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="entry_id" value="{$payment.id|intval}"><label for="payment-reason-{$payment.id|intval}">{l s='Reason for voiding' mod='colemanstay'}</label><input id="payment-reason-{$payment.id|intval}" name="reason" maxlength="500" required><button class="button secondary" name="operation" value="payment_void">{l s='Void payment' mod='colemanstay'}</button></form></details>{/if}</article>{foreachelse}<p>{l s='No payments recorded yet.' mod='colemanstay'}</p>{/foreach}</section>
<aside class="message-context">{if !$is_portal}<h2>{l s='Add monthly rent' mod='colemanstay'}</h2><p>{l s='Enter agreed rent only. No amount is assumed from an enquiry.' mod='colemanstay'}</p><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<label for="period">{l s='Rent month' mod='colemanstay'}</label><input type="month" name="period" id="period" required><label for="due">{l s='Due date' mod='colemanstay'}</label><input type="date" name="due" id="due" required><label for="charge-amount">{l s='Rent amount · USD' mod='colemanstay'}</label><input id="charge-amount" name="amount" inputmode="decimal" required><button class="button primary" name="operation" value="charge_add">{l s='Add rent charge' mod='colemanstay'}</button></form>{else}<h2>{l s='Questions about a payment?' mod='colemanstay'}</h2><p>{l s='Contact your host if a payment is missing or a record looks incorrect. Download a receipt beside each recorded payment.' mod='colemanstay'}</p>{/if}</aside></div>
{elseif $rental_section == 'maintenance'}
<div class="message-layout"><section><h2>{l s='Maintenance requests' mod='colemanstay'}</h2>{foreach $rental.maintenance as $ticket}<article class="rental-card ledger-entry"><div class="request-heading"><h3>{$ticket.title|escape:'html':'UTF-8'}</h3><span class="status">{if $ticket.status == 'resolved'}{l s='Resolved' mod='colemanstay'}{elseif $ticket.status == 'scheduled'}{l s='Scheduled' mod='colemanstay'}{else}{l s='Open' mod='colemanstay'}{/if}</span></div><p class="field-hint">#{$ticket.id|intval} · {$ticket.created|escape:'html':'UTF-8'} UTC</p><p class="message">{$ticket.description|escape:'html':'UTF-8'}</p>{if $ticket.scheduled}<p>{l s='Scheduled for' mod='colemanstay'}: {$ticket.scheduled|escape:'html':'UTF-8'}</p>{/if}{if $ticket.update}<p class="message">{$ticket.update|escape:'html':'UTF-8'}</p>{/if}
{foreach $rental.files as $file}{if $file.kind == 'photo' && $file.ticket_id == $ticket.id}<form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="file_id" value="{$file.id|escape:'html':'UTF-8'}"><button class="button secondary" name="operation" value="file_download">{l s='Download photo' mod='colemanstay'}</button></form>{/if}{/foreach}
{if !$is_portal}<details><summary>{l s='Update request' mod='colemanstay'}</summary><form method="post" action="{$rental_url|escape:'html':'UTF-8'}" class="host-form">{include file='./tenancy-fields.tpl'}<input type="hidden" name="entry_id" value="{$ticket.id|intval}"><label for="status-{$ticket.id|intval}">{l s='Status' mod='colemanstay'}</label><select id="status-{$ticket.id|intval}" name="status"><option value="open"{if $ticket.status == 'open'} selected{/if}>{l s='Open' mod='colemanstay'}</option><option value="scheduled"{if $ticket.status == 'scheduled'} selected{/if}>{l s='Scheduled' mod='colemanstay'}</option><option value="resolved"{if $ticket.status == 'resolved'} selected{/if}>{l s='Resolved' mod='colemanstay'}</option></select><label for="scheduled-{$ticket.id|intval}">{l s='Scheduled date' mod='colemanstay'}</label><input type="date" id="scheduled-{$ticket.id|intval}" name="scheduled" value="{$ticket.scheduled|escape:'html':'UTF-8'}"><label for="cost-{$ticket.id|intval}">{l s='Cost record · USD (host only)' mod='colemanstay'}</label><input id="cost-{$ticket.id|intval}" name="cost" inputmode="decimal" value="{$ticket.cost|escape:'html':'UTF-8'}"><label for="update-{$ticket.id|intval}">{l s='Update visible to resident' mod='colemanstay'}</label><textarea id="update-{$ticket.id|intval}" name="update" maxlength="2000" rows="3">{$ticket.update|escape:'html':'UTF-8'}</textarea><button class="button primary" name="operation" value="maintenance_update">{l s='Save maintenance update' mod='colemanstay'}</button></form></details>{/if}
{if isset($ticket.updates)}<details><summary>{l s='Request history' mod='colemanstay'}</summary>{foreach $ticket.updates as $update}<p class="field-hint">{$update.date|escape:'html':'UTF-8'} UTC · {$update.status|escape:'html':'UTF-8'}{if $update.scheduled} · {$update.scheduled|escape:'html':'UTF-8'}{/if}</p><p class="message">{$update.update|escape:'html':'UTF-8'}</p>{/foreach}</details>{/if}</article>{foreachelse}<div class="rental-card"><p>{l s='No maintenance requests yet.' mod='colemanstay'}</p></div>{/foreach}</section>
<aside class="message-context">{if $is_portal && $rental.lease.maintenance_enabled}<h2>{l s='Request a repair' mod='colemanstay'}</h2><p>{l s='For urgent problems, contact your host directly. This form is not monitored continuously.' mod='colemanstay'}</p><form method="post" enctype="multipart/form-data" action="/portal" class="host-form">{include file='./tenancy-fields.tpl'}<label for="title">{l s='What needs attention?' mod='colemanstay'}</label><input id="title" name="title" maxlength="120" required><label for="description">{l s='Details and access preferences' mod='colemanstay'}</label><textarea id="description" name="description" maxlength="2000" rows="5" required></textarea><label for="document">{l s='Photo (optional) · JPEG or PNG, up to 5 MB / 12 MP' mod='colemanstay'}</label><input id="document" name="document" type="file" accept="image/jpeg,image/png"><button class="button primary" name="operation" value="maintenance_add">{l s='Send repair request' mod='colemanstay'}</button></form>{elseif $is_portal}<h2>{l s='Maintenance access' mod='colemanstay'}</h2><p>{l s='Your host will enable repair requests when your rental is ready.' mod='colemanstay'}</p>{else}<h2>{l s='Keep residents informed' mod='colemanstay'}</h2><p>{l s='Residents add requests and photos in their portal. Enable access under Lease & move-in.' mod='colemanstay'}</p><p>{l s='Updates are visible in the portal. Saving a request does not send messages, dispatch a contractor or authorize spending.' mod='colemanstay'}</p>{/if}</aside></div>
{/if}
</fieldset>
{if !$is_portal && $rental_history}<details class="rental-audit"><summary>{l s='Recent record activity' mod='colemanstay'}</summary><ol>{foreach $rental_history as $event}<li>{$event.date_add|escape:'html':'UTF-8'} UTC · {$event.action|replace:'_':' '|escape:'html':'UTF-8'} · {if $event.employee_id}{l s='Host' mod='colemanstay'} #{$event.employee_id|intval}{else}{l s='Applicant / resident' mod='colemanstay'}{/if} · v{$event.revision|intval}</li>{/foreach}</ol></details>{/if}
{/if}
